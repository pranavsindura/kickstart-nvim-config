{
  "React Native Style Sheet": {
    "prefix": "rnss",
    "body": [
      "import { StyleSheet } from 'react-native';",
      "",
      "const styles = StyleSheet.create({$1});",
      "",
      "export default styles;",
      ""
    ],
    "description": "Create React Native Style Sheet"
  },
  "React Native Export Default": {
    "prefix": "rned",
    "body": ["export { default } from '$1';", ""],
    "description": "Create React Native Export Default"
  },
  "Destructure Object": {
    "prefix": "do",
    "body": ["const {$2} = $1;"],
    "description": "Destructure an Object"
  },
  "Destructure Array": {
    "prefix": "da",
    "body": ["const [$2] = $1;"],
    "description": "Destructure an Array"
  },
  "Next.js Route": {
    "prefix": "nxr",
    "body": [
      "interface $2Context {",
      "\tparams: {$3};",
      "}",
      "",
      "export async function $1(request: Request, context: $2Context) {$4}"
    ]
  }
}
